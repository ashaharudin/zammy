# Copy to .env for local development. .env is gitignored — never commit a real key.
# Every value here is validated by @zammy/config at boot; the process refuses to
# start on bad config rather than failing mysteriously later (ARCHITECTURE 12).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- data stores (docker compose up -d postgres redis) ---
DATABASE_URL=postgres://zammy:zammy@localhost:5432/zammy

# The SESSION-scoped connection, read ONLY by `pnpm db:migrate` and `pnpm chores`.
# Leave it unset when one Postgres server answers everything, as Compose does.
#
# It earns its keep behind a pooler. Both of those hold a SESSION-scoped advisory
# lock (migrator.ts, chores-cli.ts), and a transaction-mode pooler hands each
# statement whatever backend is free — so the lock is taken on one backend and
# looked for on another, pg_try_advisory_lock returns true every time, and the
# exactly-once it exists to buy is gone with nothing in the logs to say so. Point
# this at the pooler's session mode (Supabase: port 5432, not 6543) and leave
# DATABASE_URL on the transaction-mode port for the request path.
# DATABASE_SESSION_URL=

# Request-path pool size, per process. 10 suits a server with a known replica
# count; a platform that scales instances elastically gives every instance its
# own pool, so set 1-2 there (RESEARCH-VERCEL-SUPABASE 4.3).
DATABASE_POOL_MAX=10

# TLS to Postgres. disable (the Compose server offers none) | require (encrypt,
# do NOT verify) | verify-full (encrypt and verify against DATABASE_CA_CERT).
#
# NEVER put sslmode= in the URLs above — @zammy/config refuses one, because
# node-postgres silently ignores this setting whenever the URL carries sslmode,
# leaving TLS at libpq's default while the code says otherwise.
DATABASE_SSL=disable
# The PEM chain verify-full checks against, pasted whole. Escaped \n newlines are
# accepted, so a single-line value from a secret store works.
# DATABASE_CA_CERT=

REDIS_URL=redis://localhost:6379

# Which transport carries the ingest queue (ARCHITECTURE 9.1).
#   bullmq  jobs in Redis, drained by a worker inside this process. What a
#           persistent process wants, and what `docker compose up` runs.
#   vercel  a hosted Vercel Queues topic in push mode, drained by a separate
#           function with no public URL (VERCEL-ALL-IN-SCOPE 3.2). Set this ONLY
#           on Vercel: `vercel.json`'s queue trigger names the topic, and the
#           driver publishes to it. Redis stays either way — the pending set
#           behind meta.ingest is the same registry under both.
INGEST_QUEUE_DRIVER=bullmq

# CRON_SECRET gates the three scheduled routes — POST /api/drain, /api/chores
#             and /api/keepalive (docs/chores.md). Left unset here on purpose:
#             all three are Vercel-only, and unset DISABLES them rather than
#             opening them. Compose and local dev have none of them and need no
#             token. Set it only where they are deployed, to a long random
#             string, and expect `Authorization: Bearer $CRON_SECRET`.
#             NOTE the cost of leaving it unset THERE: it also disables the
#             Supabase pause guard, so a free project with no CRON_SECRET is a
#             project that will eventually pause.
# CRON_SECRET=

# --- upstream ---
# CURRENTS_MODE=fixture serves the recorded payloads in ./fixtures instead of
# calling the API. The free tier allows only 1000 calls/day, which a dev server
# with hot reload will exhaust before lunch — so fixture is the default.
CURRENTS_MODE=fixture
# Resolved against the api process cwd (apps/api under `pnpm dev`), so point
# back at the repo-root fixtures; the ./fixtures default only works from root.
FIXTURES_DIR=../../fixtures
CURRENTS_API_KEY=
CURRENTS_BASE_URL=https://api.currentsapi.services/v1

# MUST be set and non-empty: Cloudflare returns 403 (error 1010) to default
# library User-Agents. Verified during the API probe — see PROBE-FINDINGS.md 2.
# Quoted because it contains characters that break `set -a; . ./.env`.
CURRENTS_USER_AGENT="zammy/0.1 (+https://github.com/your-org/zammy)"

# --- upstream limits (verified against the Free tier; see PROBE-FINDINGS.md 1) ---
# Read from x-ratelimit-* headers at runtime, but bounded by these so a missing
# header never means "unlimited".
CURRENTS_MAX_PAGE_SIZE=20
CURRENTS_MAX_RETRIEVABLE_RESULTS=100
CURRENTS_MAX_LOOKBACK_DAYS=30
# Per-call date range ceiling. Upstream drift observed 2026-08-11:
# "date_range: Max range is 7 days" (PROBE-FINDINGS 6d).
CURRENTS_MAX_RANGE_DAYS=7
CURRENTS_DAILY_CALL_LIMIT=1000
CURRENTS_BURST_CALL_LIMIT=60

# --- second provider: GNews (ARCHITECTURE 5.6) ---
# Off by default, and with it off nothing about the system's behaviour changes:
# the factory returns the Currents client bare, with no fan-out and no wrapper.
#
# Switched on, every search and breadth sample fans out to both providers and
# the results are merged. The two are deliberately NOT equals. Currents stays
# coverage-bearing — it alone decides when a window is finished, and its
# failures still fail the call. GNews is best-effort breadth: when it errors,
# sits out a query it cannot express, or runs out of budget, the call still
# succeeds and the sit-out is reported in the response's `adjustments`, in a
# warn log, and in /readyz. The trade-off is written up in
# packages/news-providers/src/composite.ts.
GNEWS_ENABLED=false
# fixture serves ./fixtures/gnews-search-sample.json — whose SHAPE is the
# documented v4 response but whose CONTENT is the recorded Currents articles
# reshaped, because no key was available to capture live payloads.
GNEWS_MODE=fixture
GNEWS_API_KEY=
GNEWS_BASE_URL=https://gnews.io/api/v4
# Optional. Falls back to CURRENTS_USER_AGENT, which is already required.
GNEWS_USER_AGENT=

# Free plan, from gnews.io/pricing: 100 requests/day, 10 articles/request,
# 30 days of history. Raise these together when the plan changes.
GNEWS_MAX_PAGE_SIZE=10
# GNews allows 1000 articles of paging, but ten pages is already a tenth of the
# daily budget spent on one window, so the practical ceiling is far lower.
GNEWS_MAX_RETRIEVABLE_RESULTS=100
GNEWS_MAX_LOOKBACK_DAYS=30
# No documented per-call range ceiling, unlike the Currents 7 days. The
# composite narrows to whichever provider is stricter anyway.
GNEWS_MAX_RANGE_DAYS=30
GNEWS_DAILY_CALL_LIMIT=100
# 1 request per second on the Free plan — a different SHAPE of window from the
# Currents 60-per-60s, hence the separate window setting. A burst refusal makes
# GNews sit a call out rather than failing it, so this paces the supplement.
GNEWS_BURST_CALL_LIMIT=1
GNEWS_BURST_WINDOW_MS=1000
# The same quarter of the budget INTERACTIVE_RESERVE holds back, sized for 100
# calls rather than 1000. Reusing 250 here would exceed the whole daily limit
# and silently make this provider interactive-only.
GNEWS_INTERACTIVE_RESERVE=25

# --- third provider: Google News RSS ---
# docs/DESIGN-DISCOVERY-AND-DEEPENING.md. Built for the deepening plane — ~18
# months of keyword-searchable, date-windowed breadth across every outlet at
# once, against Currents' 30 days — and intended to serve search and breadth as
# well, which is why ADR-0019 replaced ADR-0012's provider ranking: coverage is
# per (subject, provider, span), and what a fetch may feed is decided by why it
# was made rather than by who answered.
#
# Not part of the GNews fan-out above. It has no offset parameter at all, so it
# cannot share a page plan with anything.
#
# Off by default, and unreachable while it is — createGoogleNewsClient refuses
# to build a client at all. The two hazards that made that urgent are now
# guarded: G1's `alt_key` landed (migration 0020) and this adapter derives one,
# and G2's ranker isolation landed. What is still missing is a destination —
# G3's storyline_coverage does not exist, and nothing calls the factory. G5
# writes the attachment rules and does the wiring.
GOOGLE_NEWS_ENABLED=false
# fixture serves ./fixtures/google-news-search-{capped,deep}.xml — genuine live
# captures, verbatim apart from an inserted provenance comment.
GOOGLE_NEWS_MODE=fixture
GOOGLE_NEWS_BASE_URL=https://news.google.com/rss
# Optional. Falls back to CURRENTS_USER_AGENT, which is already required.
# There is no API key here, so this is the ONLY thing identifying the client —
# and a default library UA earns a 403 (PROBE-FINDINGS 2).
GOOGLE_NEWS_USER_AGENT=
# The default EDITION, not a filter: an edition biases which articles come back
# rather than restricting them (one query across CA/US/GB/IN shared 30-50% of
# its titles, and axios.com appeared in all four). hl/gl/ceid are derived from
# this pair, because the three are not independent: hl is <lang>-<COUNTRY>, gl
# is the country, ceid is <COUNTRY>:<lang>.
GOOGLE_NEWS_LANGUAGE=en
GOOGLE_NEWS_COUNTRY=CA
# Two years, deliberately past the 573 days actually measured (a Feb-2025
# window answered on 2026-08-28). Nothing here is documented and there is no
# 400 to avoid — an over-old window answers 200 with few items — so asking too
# deep costs a wasted call, while clamping too shallow silently narrows a
# window that then gets recorded as covered.
GOOGLE_NEWS_MAX_LOOKBACK_DAYS=730
# A budget WE INVENTED. No key, no published ceiling, no rate-limit header, so
# quota() returns null forever and the governor is never corrected by upstream.
# Every other limit in this file was transcribed from something a provider told
# us; these two were not, so they are set low and raised only on measurement.
# GDELT is the cautionary shape: 1 of 6 probe calls answered, the failures
# arriving as silent 30-75s connection timeouts rather than as a 429.
GOOGLE_NEWS_DAILY_CALL_LIMIT=200
GOOGLE_NEWS_BURST_CALL_LIMIT=5
GOOGLE_NEWS_BURST_WINDOW_MS=60000
GOOGLE_NEWS_INTERACTIVE_RESERVE=50
# Note the two settings that are NOT here: page size and retrievable results.
# The endpoint returns at most 100 items and has no offset parameter, and
# neither is a tier anyone could buy up, so both are constants in the adapter.

# --- ingestion budget (ARCHITECTURE 6.3, 9.4) ---
SYNC_FILL_DEADLINE_MS=1200
MAX_SYNC_UPSTREAM_CALLS=5
INTERACTIVE_RESERVE=250
# 2% of the pool per topic. The coverage frontier (§6.3) makes every capped
# call durable progress, so dense keywords deepen ~400 articles/day across
# days instead of needing a bigger single-day budget (§9.4).
PER_TOPIC_DAILY_CALL_CAP=20
INGEST_POLL_MAX=8
# Per-IP ceiling on /api/v1/* — novel-fingerprint spam can mint topics (§9.4).
RATE_LIMIT_PER_MINUTE=60
# How many reverse proxies sit in front of this process, so the ceiling above keys
# on the real caller. 0 for local dev (nothing in front), 1 behind a single load
# balancer or platform edge, 2 if a TLS-terminating proxy is added in front of that.
# It must MATCH the topology: over-counting trusts a client-supplied X-Forwarded-For
# entry and hands every caller an unlimited bucket, which is the bug a boolean `true`
# had. Under-counting is the safe error.
TRUSTED_PROXY_HOPS=0

# --- storage (ARCHITECTURE 7.5) ---
# Upstream lookback is 30 days, so anything older than that is unrecoverable if
# deleted. Widen this freely; narrow it only deliberately.
RETENTION_DAYS=90

# --- article grouping (ARCHITECTURE 14.3, ADR-0005) ---
# Show one story covered by several outlets as ONE timeline slot, the rest
# behind "related". Every article row is kept either way; false disables the
# grouping pass and pages every article as its own slot again.
GROUPING_ENABLED=true
# Headline-token Jaccard floor for "same story". UNMEASURED — raise it if
# related-but-distinct stories start collapsing. Candidates are always bounded
# to one APP_TIMEZONE day, so this only ever loosens within a day.
GROUPING_SIMILARITY_THRESHOLD=0.5

# --- storylines (ADR-0011) ---
# There is no storyline on/off switch: the timeline pages over storyline_days,
# so every group's provisional storyline-of-one is what puts a row there.
# Turning linking off does not degrade the timeline, it empties it.
#
# Days of articles the storyline linker measures token rarity against. A
# storyline is unbounded in time, so day-relative rarity cannot serve it: the
# same token would be rare on Monday and common on Wednesday. Also what the
# nightly prune keeps, plus a day of slack. See docs/TRAILING-CORPUS.md.
STORYLINE_DF_WINDOW_DAYS=14
# A shared token anchors a link only below this share of the trailing corpus.
# MEASURED: 0.002 (~32 articles of a 16k fortnight) is where beat-and-boilerplate
# storylines stop forming. See docs/STORYLINE-LINKING.md.
STORYLINE_ANCHOR_MAX_SHARE=0.002
# Floor under that share, in articles. UNMEASURED: English never reaches it.
STORYLINE_ANCHOR_DF_FLOOR=10
# Floor on the summed rarity of what a group and a storyline share. MEASURED at
# 20: 41% of groups attach, largest storyline 0.18% of the corpus. NOT the lever
# against boilerplate — raising it makes disclaimer-shaped storylines worse.
STORYLINE_MASS_THRESHOLD_V2=20
# K: independent groups that must bridge two storylines before they merge.
# MEASURED: K=1 quadruples merges for no gain — single-bridge percolation.
STORYLINE_MERGE_BRIDGES=2
# At most this many of a group's qualifiers may BRIDGE, best mass first. 0 is
# UNBOUNDED, which is the default and today's behaviour. `bridgePairs` is the
# full O(n^2) cross-product, so a 40-qualifier group writes 780 pairs, and that
# pair count — not K — is what feeds the loop: more pairs reach K, each merge
# unions two profiles, mergeStorylines re-points the loser's bridges onto the
# winner, and a wider profile overlaps more next time. MEASURED (retrieval
# NARROWED, K=2, cascade modelled): on the birth path the top 2 takes the largest
# arc from 2,591 groups to 22, where K would have to reach 6 for 85. There is no
# gentle version — 3 leaves 2,760 and 5 leaves 4,145 — so this is a switch
# wearing a number's clothes. It is not free either: it removes most of the
# merge, which ADR-0011 makes the only repair err-narrow formation has, and
# hand-reading says the FedEx/PGA run comes out as a 23-group arc where the sweep
# built a 151-group FIFA arc judged coherent. Turn it on WITH
# STORYLINE_NARROW_RETRIEVAL, not instead of it — narrowing is what widens the
# qualifier set (26% of the live archive's bridging groups exceed 2 qualifiers
# narrowed, 0.5% broad), and this is what makes that safe. Bounds the PAIRING
# only: the attach still takes the group's best qualifier.
# See docs/STORYLINE-LINKING.md, "Bounding what one group may bridge".
STORYLINE_MAX_BRIDGING_QUALIFIERS=0
# Days without coverage before a storyline leaves the normal candidate set, and
# how much harder it is to join once it has. Both UNMEASURED: the dev archive is
# 31 days, so 30/90/365 replay identically. The backfill can measure these.
STORYLINE_DORMANCY_DAYS=90
STORYLINE_DORMANT_STRICTNESS=1.5
# Probe candidate retrieval with the ANCHOR-ELIGIBLE subset of a group's profile,
# capped at 4,000 rows, instead of the whole profile capped at 200. ONE flag for
# both halves: the subset is safe because it is a necessary condition, 4,000 is
# safe because it was censused against that subset (binds on 0 of 12,366 window
# groups), and whole profile + 4,000 is neither behaviour — it is the broad probe
# (p50 1,903 rows) with its only bound removed, feeding an O(n^2) bridge
# cross-product. OFF, and the default is a measurement: narrowing repairs the
# birth path (the 200-row cut bound on 12,266 of 12,366 groups, discarding ~90% of
# candidates by coverage recency), but the cap was also doing the bounding K was
# believed to be doing — modelled WITH mergeStorylines' bridge re-pointing, the
# birth path alone leaves a largest arc of 2,591 groups (9.96%) where the harness
# that skipped the merge reported 72. Turning it on is blocked on re-measuring K
# against a harness that models the merge, then a fortnight of the nightly graph
# numbers with it on. If it percolates, the only repair is
# `backfill:storylines --restart`, which discards every model label (~8 days of
# free-tier quota). See docs/VERCEL-PHASE-0-FINDINGS.md 2.5-2.7.
STORYLINE_NARROW_RETRIEVAL=false

# Run the nightly late-candidate sweep. OFF, and the default is a measurement:
# with candidate retrieval narrowed (it truncates to 200 rows on 99% of
# groups) the sweep's re-offers percolate — four passes over 2,000 groups took
# the largest storyline from 124 to 201, and the 201 chains three unrelated
# wars. Blocked on re-measuring K against a replay that re-offers groups; the
# replay that pinned K=2 models birth-time offers only. `pnpm chores storylines
# --late-candidates` runs it for one night, against a clone, with an operator
# watching the graph shape. See docs/STORYLINE-LINKING.md (2026-08-22).
STORYLINE_LATE_CANDIDATE_SWEEP=false

# Re-offer a group to the linker when an arriving article JOINS it, on the ingest
# tail. Off ships, and it now shares the sweep's blocker rather than its own. The
# candidate cap that was the original reason to wait lifts only with
# STORYLINE_NARROW_RETRIEVAL on, and against the narrowed retrieval the trigger is
# worth 1.39x the retroactive arcs and 2.33x the merges of a control cohort — but
# merges are what percolate, so this waits on the same K re-measurement
# STORYLINE_LATE_CANDIDATE_SWEEP waits on. On the OLD capped retrieval it bought
# nothing measurable (42 arcs against a control's 29, ~1.5 sigma).
STORYLINE_REOFFER_JOINED_GROUPS=false
# Narrow the nightly late-candidate sweep to the groups whose candidate set could
# have changed (`storylines.link_dirty_at`). MEASURED: ~12s a night against
# ~275s. Off ships for two reasons — the marker column starts empty, so the first
# filtered night would be a silent no-op that reports a clean tally; and it gives
# up "every group in the window, every night" (ARCHITECTURE 9.1 lists what that
# stops covering). Deploy, let a night of markers accumulate, then flip.
# `chores storylines --full` runs the unscoped pass whatever this says.
STORYLINE_LATE_CANDIDATE_CHANGED_ONLY=false

# --- storyline labels (ADR-0011, "Labels") ---
# The repo's first external model dependency, and optional on purpose: with no
# key the labeler falls back to the bigram extractor, and failing that leaves
# the storyline label-less, which renders. Labels run at storyline volume
# (promotion, merge, drift), never per article — see docs/STORYLINE-LABELS.md
# for the measured cost per thousand.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# NOT the flash tier any more (ADR-0011, amended 2026-08-28): `gemma-4-26b-a4b-it`
# publishes double the free-tier rpm — 30 against flash-lite's 15 — and names a
# storyline just as well. Pinned, not `gemini-flash-latest`: the same coverage
# should name the same story on a replay. gemini-2.5-flash is refused for new
# keys (measured 2026-08-14).
GEMINI_MODEL=gemma-4-26b-a4b-it
# How hard the model may think first. Empty omits the field, and for the model
# above empty is the ONLY legal setting: gemma 400s on any value, and thinks
# unconfigurably regardless — budgeted for by `maxOutputTokens` in gemini.ts
# rather than capped here. `low` is the floor a Gemini 3.x flash model accepts,
# if you switch back to one.
GEMINI_THINKING_LEVEL=
# Nothing waits on a label, and a timeout costs one. 20s was generous for a
# model that answered in ~7-8s (flash-lite, 2026-08-14). Whether it is generous
# for the current one is OPEN: on 2026-08-28 gemma timed out on 5 of 5 dev-key
# calls and took 20.6-43.4s when allowed to finish — but every one of those was
# a call that spent its whole token budget thinking and returned no answer
# (MAX_TOKENS, 2,046 thought tokens), so they time a FAILING call, not a label.
# See CHORE_MAX_LABELS below. Re-measure on calls that answer before moving it.
GEMINI_TIMEOUT_MS=20000
# The tier's published request ceiling, per minute — 30 for the model above,
# where flash-lite was 15. THE KNOB: raise it with the plan and every label path
# follows, because the client enforces it once for the key rather than each
# caller pacing itself.
GEMINI_MAX_RPM=30
# Storylines one nightly label pass may relabel — a DEPLOYMENT parameter, not an
# operator convenience (VERCEL-ALL-IN-SCOPE §3.3).
#
# 50 is Phase 0's 40-60, which counted PACING ONLY: 75 x 4s at the old 15 rpm
# filled the 300s Vercel Hobby ceiling. But `labelPass` is sequential — it sleeps
# the spacing and THEN awaits the call — so a label costs spacing PLUS latency,
# which that range dropped. That much stands whatever the model does, and it is
# why a COUNT is a poor bound on a CLOCK.
#
# The replacement number is NOT settled, and this comment will not invent one.
# Measuring it on 2026-08-28 (dev key, real prompts, pacer off) instead found an
# outage: gemini.ts joined the model's THOUGHT parts into its answer, so every
# call came back failing the label contract, and each burned a full generation to
# MAX_TOKENS (2,046 thought tokens, no answer) in 20.6-43.4s. Those seconds time
# a call that produced nothing — they are not what a working label costs, and the
# ~11-label window they imply is not a figure to size anything against. Flash-
# lite, for scale on the same prompts, answered in ~0.9s.
#
# The parsing fix landed in #177, along with CHORE_LABEL_BUDGET_MS — a wall-clock
# bound, which is the RIGHT shape for this and the reason 50 is no longer load-
# bearing. 50 stays until someone re-measures latency on calls that ANSWER and
# re-derives it from that. Meanwhile the overrun is soft: the pass is resumable
# across nights, so a bound defers labels rather than dropping them, and what a
# truncated night costs is the `chore_runs` row and the passes ordered after the
# label one. The daily quota is no part of this either way (14,400/day for this
# model, not the 500/day the older docs reason from). `--max-labels` (or
# ?max-labels= on the route) overrides it for one run.
CHORE_MAX_LABELS=50
# The OTHER half of that bound, and the half that is actually about the
# function's deadline: a wall-clock ceiling for one label pass. The count above
# only bounds the clock if a label costs what the count was sized against, and
# on 2026-08-28 production ran 50 labels in ~25 minutes — the function was killed
# at 300s, the chore_runs row stayed open, and the label-merge and graph passes
# never ran. 240s leaves 60s of the route's 300s maxDuration for the passes
# ordered after this one. Raise it with maxDuration, never past it. The CLI
# passes nothing, which is unbounded.
CHORE_LABEL_BUDGET_MS=240000
# How long a label waits for a slot before giving up and taking the bigram
# fallback. Bounds the queue a promotion burst can build in the live tail.
GEMINI_MAX_RATE_WAIT_MS=120000
# Relabel once membership has multiplied by this since the label was made.
STORYLINE_LABEL_DRIFT_FACTOR=2
# Member headlines shown to the model per label.
STORYLINE_LABEL_SAMPLE=10
# The label-agreement merge: two storylines the MODEL independently gave the
# same name, whose coverage runs together, are one story (ADR-0011, "Labels").
# Days of silence a shared label may bridge. MEASURED on the 855-label dev
# archive: 14 is the only value that merges the Shanahan crash (12-day gap, one
# story) while leaving the Canada tariff rounds apart (19-day gap, two arcs).
# See docs/STORYLINE-LABELS.md.
STORYLINE_LABEL_MERGE_GRACE_DAYS=14
# Safety valve on one label's component, in storylines — not a tuning knob. A
# label both generic AND grounded would otherwise collapse an unbounded number
# of arcs in one pass; a refused component is logged by name and left alone.
STORYLINE_LABEL_MERGE_MAX_COMPONENT=25
# How many live storylines must share a label before the ingest tail runs the
# merge for that label, without waiting for the nightly chore. 0 turns the
# trigger off. 2 is the merge's own bar; anything higher leaves pairs standing
# until a scheduled pass runs. See docs/STORYLINE-LABELS.md.
STORYLINE_LABEL_MERGE_TRIGGER=2

# --- landing-page wordcloud (ARCHITECTURE 10.1, ADR-0008, ADR-0013, ADR-0014) ---
# The local calendar day ARTICLE GROUPING is bounded by (a group never spans
# two local days). The wordcloud does NOT use this — it rolls a window instead.
APP_TIMEZONE=UTC
# How far back the cloud looks: the storylines updated inside this many hours.
# Rolls with the clock; no midnight reset. BASELINE_WINDOW_DAYS went with the
# term cloud it suppressed and did not come back (ADR-0013).
TREND_WINDOW_HOURS=24
# How fast a storyline's position ages. Rank is its window article count times
# 0.5 ^ (age / this), so at 8 hours a story that last moved 8 hours ago needs
# twice the coverage of one moving now to rank level with it (ADR-0014, reviving
# ADR-0008's decay). Much shorter than the window above and the window's older
# half is decorative; much longer and the decay does nothing.
TREND_HALF_LIFE_HOURS=8
# How long a /v2/latest-news snapshot stays fresh; the first visitor after it
# stales triggers the next sample.
SAMPLE_REFRESH_MINUTES=60
# Pages (~20 articles each) per sample. Daily worst case: this x 24 calls per
# language (2 -> ~5% of quota). Max 5 — deeper is unverified upstream.
SAMPLE_PAGES=2

# --- web ---
# Pinned per environment, never a permissive default (ARCHITECTURE 12). The
# browser fetches /api/v1/* relative (apps/web/src/api.ts), so a deployment that
# serves web and api from ONE origin sets this to that origin and crosses no
# boundary at all; two origins means the web one, exactly.
CORS_ORIGIN=http://localhost:5173
