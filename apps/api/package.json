{
  "name": "@zammy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//exports": "An app, not a library — but the Vercel function entrypoints at the repo root (api/) have to import it, and Vercel resolves them as ordinary node specifiers. Only what an entrypoint needs is exposed.",
  "exports": {
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    },
    "./vercel-queue": {
      "types": "./dist/vercel-queue.d.ts",
      "default": "./dist/vercel-queue.js"
    },
    "./drain": {
      "types": "./dist/drain.d.ts",
      "default": "./dist/drain.js"
    },
    "./chores": {
      "types": "./dist/chore-route.d.ts",
      "default": "./dist/chore-route.js"
    },
    "./keepalive": {
      "types": "./dist/keepalive.d.ts",
      "default": "./dist/keepalive.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && { tsc -b --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/index.js; }",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "chores": "tsc -b && node --env-file-if-exists=../../.env dist/chores-cli.js",
    "regroup": "tsc -b && node --env-file-if-exists=../../.env dist/regroup-cli.js",
    "story:df": "tsc -b && node --env-file-if-exists=../../.env dist/story-df-cli.js",
    "label:storylines": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-label-cli.js",
    "merge:storyline-labels": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-label-merge-cli.js",
    "backfill:storylines": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-backfill-cli.js",
    "backfill:label-words": "tsc -b && node --env-file-if-exists=../../.env dist/label-words-backfill-cli.js",
    "measure:storylines-v2": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-sweep-cli.js",
    "measure:storyline-coherence": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-coherence-cli.js",
    "dissolve:storyline-piles": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-dissolve-cli.js",
    "measure:deepening-yield": "tsc -b && node --env-file-if-exists=../../.env dist/deepening-yield-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@vercel/functions": "^3.9.5",
    "@vercel/queue": "^0.3.0",
    "@zammy/config": "workspace:*",
    "@zammy/currents-client": "workspace:*",
    "@zammy/google-news-client": "workspace:*",
    "@zammy/news-client": "workspace:*",
    "@zammy/news-providers": "workspace:*",
    "@zammy/shared": "workspace:*",
    "@zammy/storage": "workspace:*",
    "bullmq": "^6.0.9",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "kysely": "^0.28.17",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
