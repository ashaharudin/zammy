{
  "name": "@zammy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && { tsc -b --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/index.js; }",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "regroup": "tsc -b && node --env-file-if-exists=../../.env dist/regroup-cli.js",
    "measure:storylines": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-measure-cli.js",
    "story:df": "tsc -b && node --env-file-if-exists=../../.env dist/story-df-cli.js",
    "measure:storylines-v2": "tsc -b && node --env-file-if-exists=../../.env dist/storyline-sweep-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@zammy/config": "workspace:*",
    "@zammy/currents-client": "workspace:*",
    "@zammy/shared": "workspace:*",
    "@zammy/storage": "workspace:*",
    "bullmq": "^6.0.9",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "kysely": "^0.28.17",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
