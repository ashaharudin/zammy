{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "fixtures/**"
    },
    "api/drain.ts": {
      "maxDuration": 300,
      "includeFiles": "fixtures/**"
    },
    "api/chores.ts": {
      "maxDuration": 300
    },
    "api/keepalive.ts": {
      "maxDuration": 15
    },
    "api/storyline.ts": {
      "maxDuration": 15,
      "includeFiles": "apps/web/dist/**"
    },
    "api/sitemap.ts": {
      "maxDuration": 15
    },
    "api/queues/ingest.ts": {
      "maxDuration": 300,
      "includeFiles": "fixtures/**",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ingest"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/readyz", "destination": "/api/index" },
    { "source": "/storyline/(.*)", "destination": "/api/storyline" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "www.zammy.info" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
