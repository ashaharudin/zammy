{
  "name": "zammy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @zammy/api dev",
    "dev:web": "pnpm --filter @zammy/web dev",
    "prototype:storylines": "pnpm --filter @zammy/web dev --open /prototype/storylines",
    "db:migrate": "pnpm --filter @zammy/storage migrate",
    "chores": "pnpm --filter @zammy/api chores",
    "regroup": "pnpm --filter @zammy/api regroup",
    "story:df": "pnpm --filter @zammy/api story:df",
    "label:storylines": "pnpm --filter @zammy/api label:storylines",
    "merge:storyline-labels": "pnpm --filter @zammy/api merge:storyline-labels",
    "backfill:storylines": "pnpm --filter @zammy/api backfill:storylines",
    "backfill:label-words": "pnpm --filter @zammy/api backfill:label-words",
    "measure:storylines-v2": "pnpm --filter @zammy/api measure:storylines-v2",
    "measure:storyline-coherence": "pnpm --filter @zammy/api measure:storyline-coherence",
    "dissolve:storyline-piles": "pnpm --filter @zammy/api dissolve:storyline-piles",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v"
  },
  "//dependencies": "The Vercel functions in api/ live at the repo root because that is where Vercel looks for them, so the api app has to be resolvable from here. Nothing else at the root imports anything.",
  "dependencies": {
    "@zammy/api": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
